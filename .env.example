NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

DATABASE_PATH=./data/store.sqlite
PRIVATE_DIR=./private/patterns
UPLOAD_DIR=./uploads
# Set to the precise number of trusted reverse proxies; leave 0 for local use.
TRUST_PROXY=0

# Store prices are stored in minor units. Payoneer must support this currency for your account.
STORE_CURRENCY=usd

# Payoneer-hosted payment request flow. Requires approved Payoneer API access.
PAYMENT_PROVIDER=payoneer
# Development-only: simulates a successful international card payment without charging a real card.
PAYMENT_TEST_MODE=true
PAYONEER_API_BASE=https://api.sandbox.payoneer.com/v4
PAYONEER_ACCOUNT_ID=
PAYONEER_ACCESS_TOKEN=
# request = the admin panel records withdrawal requests/notes only.
# Actual Payoneer withdrawals are completed in your Payoneer dashboard.
PAYOUT_MODE=request

# Optional legacy providers (leave blank when using Payoneer)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_CARD_INTENT=CYBERSOURCE

# Email / OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
OTP_SIGNING_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Bootstrap only: set these for `npm run admin:create`, then remove them.
ADMIN_USERNAME=
ADMIN_PIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin

# Admin-only secondary PKR estimate for USD reporting. Update when needed.
USD_TO_PKR_RATE=280
