NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

DATABASE_PATH=./data/store.sqlite
PRIVATE_DIR=./private/patterns
UPLOAD_DIR=./uploads
TRUST_PROXY=0
STORE_CURRENCY=usd

PAYMENT_PROVIDER=payoneer
# Development-only: simulates a successful international card payment without charging a real card.
PAYMENT_TEST_MODE=true
PAYONEER_API_BASE=https://api.sandbox.payoneer.com/v4
PAYONEER_ACCOUNT_ID=
PAYONEER_ACCESS_TOKEN=
PAYOUT_MODE=request

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
OTP_SIGNING_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

ADMIN_USERNAME=
ADMIN_PIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin

# Admin-only secondary PKR estimate for USD reporting. Update when needed.
USD_TO_PKR_RATE=280
