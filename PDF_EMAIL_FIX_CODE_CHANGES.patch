+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { assertPdfEnvelope, PDF_MAX_BYTES } from "../server/uploads.js";
+
+test("pattern PDF envelope accepts existing store PDFs and rejects invalid files", () => {
+  const existing = readFileSync(
+    new URL("../private/patterns/0347d9b9-da92-4a45-94d5-aeaea1243e27.pdf", import.meta.url),
+  );
+  assert.doesNotThrow(() => assertPdfEnvelope(existing, "pattern.pdf"));
+  assert.throws(() => assertPdfEnvelope(Buffer.from("not a pdf"), "fake.pdf"), /not a readable PDF/i);
+  assert.throws(
+    () => assertPdfEnvelope(Buffer.alloc(PDF_MAX_BYTES + 1), "huge.pdf"),
+    /under 25 MB/i,
+  );
+});
