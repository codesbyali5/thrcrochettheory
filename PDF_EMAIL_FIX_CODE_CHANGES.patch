+const PDF_MAX_BYTES = 25 * 1024 * 1024;
+
+function pdfHeaderOffset(buffer) {
+  const probe = buffer.subarray(0, Math.min(buffer.length, 1024)).toString("latin1");
+  return probe.indexOf("%PDF-");
+}
+
+export function assertPdfEnvelope(buffer, originalName = "pattern.pdf") {
+  if (!Buffer.isBuffer(buffer) || !buffer.length) {
+    const error = new Error("The selected PDF is empty. Choose a valid pattern PDF.");
+    error.status = 400;
+    throw error;
+  }
+  if (buffer.length > PDF_MAX_BYTES) {
+    const error = new Error("Use a PDF under 25 MB.");
+    error.status = 400;
+    throw error;
+  }
+
+  // The PDF spec expects the header near the beginning. Some legitimate exporters
+  // prepend a BOM/newline, so accept it within the first 1 KiB instead of only byte 0.
+  const headerOffset = pdfHeaderOffset(buffer);
+  const tail = buffer
+    .subarray(Math.max(0, buffer.length - 1024 * 1024))
+    .toString("latin1");
