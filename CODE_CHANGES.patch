@@ -0,0 +1,330 @@
+import { z } from "zod";
+import { get, all, run, transaction, now } from "./db.js";
+import { reserveOrder } from "./payments.js";
+import { fail } from "./validation.js";
+import { audit } from "./security.js";
+
+const payerSchema = z
+  .object({
+    name: z.string().trim().min(2).max(160),
+    phone: z
+      .string()
+      .trim()
+      .regex(/^\+[1-9][0-9]{6,14}$/, "Use a phone number with country code."),
+    country: z.string().trim().min(2).max(3),
+    state: z.string().trim().max(100).default(""),
+    city: z.string().trim().min(1).max(100),
+    postalCode: z.string().trim().max(20).default(""),
+  })
+  .strict();
+
+function baseUrl(config) {
+  const value = String(config.payoneerApiBase || "").trim().replace(/\/$/, "");
+  if (!value) fail(503, "Payoneer API base URL is not configured.");
+  let url;
+  try {
+    url = new URL(value);
+  } catch {
+    fail(503, "Payoneer API base URL is invalid.");
+  }
+  if (url.protocol !== "https:") fail(503, "Payoneer API base URL must use HTTPS.");
+  return value;
+}
+
+function paymentUrlAllowed(value) {
+  try {
+    const url = new URL(value);
+    return (
+      url.protocol === "https:" &&
+      (url.hostname === "payoneer.com" || url.hostname.endsWith(".payoneer.com"))
+    );
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Payoneer-hosted collection flow.
+ * Card number, expiry and CVV are intentionally never accepted by this server.
+ * The shopper completes those fields on Payoneer's PCI-controlled payment page.
+ */
+export async function createPayoneerCheckout(db, config, user, body) {
+  if (
+    body?.cardNumber ||
+    body?.card_number ||
+    body?.cvv ||
+    body?.cvc ||
+    body?.expiry ||
+    body?.expiryDate
+  )
+    fail(400, "Card details must be entered only on Payoneer's secure payment page.");
+
+  if (!config.payoneerAccessToken || !config.payoneerAccountId)
+    fail(
+      503,
+      "Payoneer Checkout is not configured yet. Add your approved Payoneer API credentials in .env.",
+    );
+
+  const billing = payerSchema.parse(body.billing || {});
+  const order = reserveOrder(db, { ...config, checkoutMinutes: 1440 }, user, body);
+  let record = get(db, "SELECT * FROM payoneer_checkouts WHERE order_id=?", order.id);
+  if (record?.payment_url && paymentUrlAllowed(record.payment_url))
+    return {
+      url: record.payment_url,
+      order_id: order.id,
+      provider: "payoneer",
+      status: record.status || "pending",
+    };
+
+  const endpoint = `${baseUrl(config)}/accounts/${encodeURIComponent(config.payoneerAccountId)}/payment-requests`;
+  const due = new Date(Date.now() + 7 * 86400000).toISOString().slice(0, 10);
+  const payload = {
+    client_reference_id: order.id,
+    amount: Number((order.total / 100).toFixed(2)),
+    currency: String(order.currency).toUpperCase(),
+    description: `THE CROCHET THEORY digital pattern order ${order.id.slice(0, 8)}`,
+    due_date: due,
+    payer: {
+      name: billing.name,
+      email: user.email,
+      phone: billing.phone,
+    },
+  };
+
+  let response;
+  try {
+    response = await fetch(endpoint, {
+      method: "POST",
+      headers: {
+        Accept: "application/json",
+        "Content-Type": "application/json",
+        Authorization: `Bearer ${config.payoneerAccessToken}`,
+      },
+      body: JSON.stringify(payload),
+      signal: AbortSignal.timeout(20000),
+    });
+  } catch {
+    fail(503, "Could not reach Payoneer. Please try again shortly.");
+  }
+
+  let data = null;
+  try {
+    data = await response.json();
+  } catch {}
+  if (!response.ok) {
+    const message =
+      data?.error_description ||
+      data?.message ||
+      data?.error ||
+      "Payoneer could not start the payment.";
+    fail(response.status >= 500 ? 503 : 400, String(message).slice(0, 500));
+  }
+
+  const result = data?.result || data;
+  const paymentUrl = result?.opa_url || result?.payment_url || result?.url;
+  const paymentRequestId = result?.payment_request_id || result?.id || null;
+  const status = String(result?.status || "pending").slice(0, 80);
+  if (!paymentUrlAllowed(paymentUrl))
+    fail(502, "Payoneer returned an invalid payment URL.");
+
+  if (record)
+    run(
+      db,
+      "UPDATE payoneer_checkouts SET payment_request_id=?,status=?,payment_url=?,billing=?,updated_at=? WHERE order_id=?",
+      paymentRequestId,
+      status,
+      paymentUrl,
+      JSON.stringify({
+        name: billing.name,
+        phone: billing.phone,
+        country: billing.country,
+        state: billing.state,
+        city: billing.city,
+        postalCode: billing.postalCode,
+      }),
+      now(),
+      order.id,
+    );
+  else
+    run(
+      db,
+      "INSERT INTO payoneer_checkouts(order_id,payment_request_id,status,payment_url,billing,created_at,updated_at) VALUES(?,?,?,?,?,?,?)",
+      order.id,
+      paymentRequestId,
+      status,
+      paymentUrl,
+      JSON.stringify({
+        name: billing.name,
+        phone: billing.phone,
+        country: billing.country,
+        state: billing.state,
+        city: billing.city,
+        postalCode: billing.postalCode,
+      }),
+      now(),
+      now(),
+    );
+
+  return {
+    url: paymentUrl,
+    order_id: order.id,
+    provider: "payoneer",
+    status,
+  };
+}
+
+
+function paymentRequestDetails(data) {
+  const result = data?.result || data || {};
+  const request = result.payment_request_details || result.paymentRequestDetails || result;
+  const payment = result.payment_details || result.paymentDetails || {};
+  return { request, payment };
+}
+
+async function fetchPaymentRequest(config, record, orderId) {
+  const base = baseUrl(config);
+  const account = encodeURIComponent(config.payoneerAccountId);
+  const candidates = [
+    `${base}/accounts/${account}/payment_request/${encodeURIComponent(orderId)}`,
+  ];
+  if (record?.payment_request_id) {
+    candidates.push(
+      `${base}/accounts/${account}/payment_request/${encodeURIComponent(record.payment_request_id)}?type=payment_request_id`,
+      `${base}/accounts/${account}/payment-requests/${encodeURIComponent(record.payment_request_id)}`,
+    );
+  }
+  let last = null;
+  for (const endpoint of candidates) {
+    let response;
+    try {
+      response = await fetch(endpoint, {
+        headers: {
+          Accept: "application/json",
+          Authorization: `Bearer ${config.payoneerAccessToken}`,
+        },
+        signal: AbortSignal.timeout(15000),
+      });
+    } catch {
+      last = { status: 503, message: "Could not reach Payoneer." };
+      continue;
+    }
+    let data = null;
+    try {
+      data = await response.json();
+    } catch {}
+    if (response.ok) return data;
+    last = {
+      status: response.status,
+      message:
+        data?.error_description ||
+        data?.message ||
+        data?.error ||
+        `Payoneer status request failed (${response.status}).`,
+    };
+    if (![400, 404, 405].includes(response.status)) break;
+  }
+  const error = new Error(String(last?.message || "Payoneer status is unavailable."));
+  error.status = last?.status || 503;
+  throw error;
+}
+
+/**
+ * Re-check a pending Payoneer payment request with Payoneer itself.
+ * Access is granted only when the response is bound to this order and contains
+ * a provider payment id plus a paid timestamp/status indicating payment is in motion.
+ */
+export async function syncPayoneerOrder(db, config, orderId) {
+  const order = get(db, "SELECT * FROM orders WHERE id=?", orderId);
+  const record = get(db, "SELECT * FROM payoneer_checkouts WHERE order_id=?", orderId);
+  if (!order || !record || order.paid_at) return order;
+  if (!config.payoneerAccessToken || !config.payoneerAccountId) return order;
+
+  let data;
+  try {
+    data = await fetchPaymentRequest(config, record, orderId);
+  } catch (error) {
+    // A status lookup must never make the storefront unavailable. Keep the order pending.
+    run(
+      db,
+      "UPDATE payoneer_checkouts SET status=?,updated_at=? WHERE order_id=?",
+      `status_check_failed:${String(error?.status || "unknown")}`.slice(0, 80),
+      now(),
+      orderId,
+    );
+    return order;
+  }
+
+  const { request, payment } = paymentRequestDetails(data);
+  const clientReference = String(request?.client_reference_id || "");
+  if (clientReference && clientReference !== order.id) return order;
+  if (request?.amount !== undefined) {
+    const minor = Math.round(Number(request.amount) * 100);
+    if (!Number.isSafeInteger(minor) || minor !== order.total) return order;
+  }
+  if (
+    request?.currency &&
+    String(request.currency).toLowerCase() !== String(order.currency).toLowerCase()
+  )
+    return order;
+
+  const statusCode = Number(request?.status);
+  const description = String(request?.status_description || request?.status || "pending");
+  const paymentId = String(payment?.payment_id || "").trim();
+  const paidOn = String(payment?.paid_on || "").trim();
+  const normalized = description.toLowerCase();
+  const paid =
+    !!paymentId &&
+    !!paidOn &&
+    (statusCode === 6 ||
+      normalized.includes("payment on its way") ||
+      normalized.includes("paid") ||
+      normalized.includes("completed"));
+  const cancelled = statusCode === 5 || normalized.includes("cancel");
+
+  transaction(db, () => {
+    run(
+      db,
+      "UPDATE payoneer_checkouts SET payment_request_id=COALESCE(?,payment_request_id),status=?,updated_at=? WHERE order_id=?",
+      request?.payment_request_id ? String(request.payment_request_id) : null,
+      description.slice(0, 80),
+      now(),
+      order.id,
+    );
+    const current = get(db, "SELECT * FROM orders WHERE id=?", order.id);
+    if (paid && !current.paid_at) {
+      run(
+        db,
+        "UPDATE orders SET status='paid',payment_intent=?,paid_at=?,reserved_until=NULL WHERE id=?",
+        `payoneer:${paymentId}`.slice(0, 255),
+        now(),
+        order.id,
+      );
+      for (const item of all(db, "SELECT product_id FROM order_items WHERE order_id=?", order.id))
+        run(
+          db,
+          "INSERT OR IGNORE INTO entitlements VALUES(?,?,?,?,?)",
+          order.user_id,
+          item.product_id,
+          order.id,
+          null,
+          now(),
+        );
+      audit(db, null, "payment.verified", order.id, {
+        provider: "payoneer",
+        payment_id: paymentId,
+        status: description,
+      });
+    } else if (cancelled && !current.paid_at) {
+      run(
+        db,
+        "UPDATE orders SET status='failed',reserved_until=NULL WHERE id=?",
+        order.id,
+      );
+      audit(db, null, "payment.cancelled", order.id, {
+        provider: "payoneer",
+        status: description,
+      });
+    }
+  });
+  return get(db, "SELECT * FROM orders WHERE id=?", order.id);
+}
