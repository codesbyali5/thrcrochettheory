+    assert.equal(checkout.provider, "payoneer");
+    assert.equal(checkout.url, "https://payoneer.com/opa/test-request");
+    assert.equal(posted.amount, 12.5);
+    assert.equal(posted.currency, "USD");
+    assert.equal("cardNumber" in posted, false);
+    assert.equal("cvv" in posted, false);
+
+    await syncPayoneerOrder(f.db, config, orderId);
+    assert.equal(get(f.db, "SELECT status FROM orders WHERE id=?", orderId).status, "paid");
+    assert.equal(
