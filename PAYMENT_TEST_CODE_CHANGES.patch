+import test from "node:test";
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { openDatabase, run, get, now } from "../server/db.js";
+import { createTestCardCheckout } from "../server/test-card.js";
+
+function fixture() {
+  const db = openDatabase(":memory:");
+  const user = { id: randomUUID(), email: "maker@example.test" };
+  run(
+    db,
+    "INSERT INTO users(id,email,password_hash,first_name,last_name,role,status,created_at) VALUES(?,?,?,?,?,?,?,?)",
+    user.id,
+    user.email,
+    "hash",
+    "Maker",
+    "Test",
+    "customer",
+    "active",
+    now(),
+  );
+  const fileId = randomUUID();
+  run(db, "INSERT INTO files VALUES(?,?,?,?,?,?)", fileId, "pdf", `${fileId}.pdf`, "pattern.pdf", 100, now());
+  const productId = randomUUID();
+  run(
+    db,
+    `INSERT INTO products(
+      id,name,price,cat,level,description,img,images,hook,yarn,time,details,tags,status,
+      featured,badge,file_id,seo_title,seo_description,created_at,updated_at,video
+    ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`,
+    productId,
+    "Test Pattern",
+    1250,
+    "Clothing",
+    "Beginner",
+    "A test digital pattern",
+    "assets/images/pattern-1.svg",
+    "[]",
+    "",
+    "",
+    "",
+    "",
+    "[]",
+    "active",
+    0,
+    "",
+    fileId,
+    "",
+    "",
+    now(),
+    now(),
+    "",
+  );
+  return { db, user, productId };
+}
+
+const config = {
+  currency: "pkr",
+  checkoutMinutes: 30,
+  paymentTestMode: true,
+  production: false,
+};
+
+const billing = {
+  name: "Maker Test",
+  phone: "+923001234567",
+  country: "PK",
+  state: "Punjab",
+  city: "Faisalabad",
+  postalCode: "38000",
+};
+
+test("test card checkout marks order paid and grants only the purchased entitlement", async () => {
+  const f = fixture();
+  try {
+    const orderId = randomUUID();
+    const result = await createTestCardCheckout(f.db, config, f.user, {
+      request_id: orderId,
+      product_ids: [f.productId],
+      code: "",
+      billing,
+      card: { brand: "visa", last4: "4242" },
+    });
+    assert.equal(result.test, true);
+    assert.equal(result.status, "paid");
+    const order = get(f.db, "SELECT status,payment_intent,paid_at FROM orders WHERE id=?", orderId);
+    assert.equal(order.status, "paid");
+    assert.match(order.payment_intent, /^testcard:visa:4242:/);
+    assert.ok(order.paid_at);
+    assert.equal(
+      get(
+        f.db,
+        "SELECT COUNT(*) n FROM entitlements WHERE user_id=? AND product_id=? AND revoked_at IS NULL",
+        f.user.id,
+        f.productId,
+      ).n,
+      1,
+    );
+  } finally {
+    f.db.close();
+  }
+});
+
+test("test card endpoint refuses raw PAN/CVV and is disabled in production", async () => {
+  const f = fixture();
+  try {
+    await assert.rejects(
+      createTestCardCheckout(f.db, config, f.user, {
+        request_id: randomUUID(),
+        product_ids: [f.productId],
+        billing,
+        card: { brand: "visa", last4: "4242" },
+        cardNumber: "4242424242424242",
+      }),
+      /Raw card details must never be sent/,
+    );
+    await assert.rejects(
+      createTestCardCheckout(f.db, { ...config, production: true }, f.user, {
+        request_id: randomUUID(),
+        product_ids: [f.productId],
+        billing,
+        card: { brand: "visa", last4: "4242" },
+      }),
+      /Test card checkout is not available/,
+    );
+  } finally {
+    f.db.close();
+  }
+});
