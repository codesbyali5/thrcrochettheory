+import { z } from "zod";
+import { all, get, now, run, transaction } from "./db.js";
+import { reserveOrder } from "./payments.js";
+import { audit, id } from "./security.js";
+import { fail } from "./validation.js";
+
+const billingSchema = z
+  .object({
+    name: z.string().trim().min(2).max(160),
+    phone: z
+      .string()
+      .trim()
+      .regex(/^\+[1-9][0-9]{6,14}$/, "Use a phone number with country code."),
+    country: z.string().trim().min(2).max(3),
+    state: z.string().trim().min(1).max(100),
+    city: z.string().trim().min(1).max(100),
+    postalCode: z.string().trim().min(1).max(20),
+  })
+  .strict();
+
+const cardSummarySchema = z
+  .object({
+    brand: z.enum(["visa", "mastercard", "amex", "discover", "diners", "jcb", "unionpay", "card"]),
+    last4: z.string().regex(/^\d{4}$/),
+  })
+  .strict();
+
+/**
+ * Local/staging-only simulated card checkout.
+ * IMPORTANT: raw PAN, expiry and CVV must never be sent to this endpoint.
+ * The browser validates test input, discards the sensitive values and sends
+ * only a non-sensitive brand + last four digits for the order receipt/audit log.
+ */
+export async function createTestCardCheckout(db, config, user, body) {
+  if (!config.paymentTestMode || config.production)
+    fail(404, "Test card checkout is not available.");
+
+  if (
+    body?.cardNumber ||
+    body?.card_number ||
+    body?.cvv ||
+    body?.cvc ||
+    body?.expiry ||
+    body?.expiryDate
+  )
+    fail(400, "Raw card details must never be sent to the store server.");
+
+  const billing = billingSchema.parse(body.billing || {});
+  const card = cardSummarySchema.parse(body.card || {});
+  const order = reserveOrder(db, { ...config, checkoutMinutes: 30 }, user, body);
+
+  transaction(db, () => {
+    const current = get(db, "SELECT * FROM orders WHERE id=?", order.id);
+    if (current.paid_at) return;
+
+    const paymentId = `testcard:${card.brand}:${card.last4}:${id()}`.slice(0, 255);
+    run(
+      db,
+      "UPDATE orders SET status='paid',payment_intent=?,paid_at=?,reserved_until=NULL WHERE id=?",
+      paymentId,
+      now(),
+      order.id,
+    );
+
+    for (const item of all(db, "SELECT product_id FROM order_items WHERE order_id=?", order.id))
+      run(
+        db,
+        "INSERT OR IGNORE INTO entitlements VALUES(?,?,?,?,?)",
+        order.user_id,
+        item.product_id,
+        order.id,
+        null,
+        now(),
+      );
+
+    audit(db, user.id, "payment.test_success", order.id, {
+      provider: "test-card",
+      brand: card.brand,
+      last4: card.last4,
+      country: billing.country,
+      city: billing.city,
+    });
+  });
+
+  return {
+    test: true,
+    provider: "test-card",
+    order_id: order.id,
+    status: "paid",
+    message: "Test payment completed. No real card was charged.",
+  };
+}
